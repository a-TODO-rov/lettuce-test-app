<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.lettuce.test</groupId>
    <artifactId>lettuce-test-app</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0-M2</version>
        <relativePath/>
    </parent>
    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- JitPack reactor-optional versions -->
        <lettuce.reactor-optional.version>reactor-optional-SNAPSHOT</lettuce.reactor-optional.version>
        <spring-data-redis.reactor-optional.version>reactor-optional-SNAPSHOT</spring-data-redis.reactor-optional.version>
    </properties>

    <dependencies>
        <!-- Connection pooling support -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>
        <!-- Micrometer for metrics -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>1.20.5</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.17.0</version>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
    </dependencies>

     <build>
         <plugins>

             <plugin>
                 <groupId>net.revelc.code.formatter</groupId>
                 <artifactId>formatter-maven-plugin</artifactId>
                 <version>2.16.0</version>
                 <configuration>
                     <directories>
                         <directory>${project.build.sourceDirectory}</directory>
                         <directory>${project.build.testSourceDirectory}</directory>
                     </directories>
                     <configFile>formatting.xml</configFile>
                 </configuration>
                 <executions>
                     <execution>
                         <goals>
                             <goal>validate</goal>
                         </goals>
                     </execution>
                 </executions>
             </plugin>
             <plugin>
                 <groupId>org.springframework.boot</groupId>
                 <artifactId>spring-boot-maven-plugin</artifactId>
             </plugin>
         </plugins>
     </build>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <!-- Spring milestone repo for Spring Boot 4.1.0-M2 -->
        <repository>
            <id>spring-milestones</id>
            <url>https://repo.spring.io/milestone</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
        <!-- Spring snapshot repo for spring-data-redis 4.1.0-SNAPSHOT -->
        <repository>
            <id>spring-snapshots</id>
            <url>https://repo.spring.io/snapshot</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <profiles>
        <!--
        =====================================================================
        DEPENDENCY PROFILES (choose one: reactor-optional or standard)
        =====================================================================
        -->

        <!--
            reactor-optional: Uses JitPack forks with reactor-optional changes.
            Lettuce and Spring Data Redis work WITHOUT reactor-core on classpath.
            This is the DEFAULT profile (activates when 'standard' property is NOT set).
            Usage: mvn spring-boot:run (or explicitly: mvn spring-boot:run -Preactor-optional)
        -->
        <profile>
            <id>reactor-optional</id>
            <activation>
                <property>
                    <name>!standard</name>
                </property>
            </activation>
            <dependencies>
                <!-- Spring Boot Redis starter WITHOUT lettuce-core and spring-data-redis -->
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-data-redis</artifactId>
                    <exclusions>
                        <exclusion>
                            <groupId>io.lettuce</groupId>
                            <artifactId>lettuce-core</artifactId>
                        </exclusion>
                        <exclusion>
                            <groupId>org.springframework.data</groupId>
                            <artifactId>spring-data-redis</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <!-- JitPack: spring-data-redis with reactor-optional support -->
                <dependency>
                    <groupId>com.github.a-TODO-rov</groupId>
                    <artifactId>spring-data-redis</artifactId>
                    <version>${spring-data-redis.reactor-optional.version}</version>
                </dependency>
                <!-- JitPack: lettuce with reactor-optional support -->
                <dependency>
                    <groupId>com.github.a-TODO-rov</groupId>
                    <artifactId>lettuce</artifactId>
                    <version>${lettuce.reactor-optional.version}</version>
                </dependency>
            </dependencies>
        </profile>

        <!--
            standard: Uses official Spring Data Redis and Lettuce from Maven Central.
            reactor-core comes transitively from lettuce-core and spring-data-redis.
            Usage: mvn spring-boot:run -Dstandard
                   mvn spring-boot:run -Dstandard -Dreactive
        -->
        <profile>
            <id>standard</id>
            <activation>
                <property>
                    <name>standard</name>
                </property>
            </activation>
            <dependencies>
                <!-- Standard Spring Boot Redis starter (reactor-core comes transitively) -->
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-data-redis</artifactId>
                </dependency>
            </dependencies>
        </profile>

        <!--
        =====================================================================
        RUNTIME MODE PROFILES (choose one: sync or reactive)
        =====================================================================
        -->

        <!--
            sync: Excludes reactive code from compilation.
            Activates by default when 'reactive' property is NOT set.
            Usage: mvn spring-boot:run (default)
        -->
        <profile>
            <id>sync</id>
            <activation>
                <property>
                    <name>!reactive</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>**/reactive/**</exclude>
                                <exclude>**/*Reactive*.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            reactive: Enables reactive mode (sets runner.mode=reactive).
            Activates when 'reactive' property IS set.
            Usage: mvn spring-boot:run -Dreactive (with -Dstandard)
                   mvn spring-boot:run -Dreactive -Dinclude-reactor-dep (with reactor-optional)
        -->
        <profile>
            <id>reactive</id>
            <activation>
                <property>
                    <name>reactive</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <runner.mode>reactive</runner.mode>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            include-reactor-dep: Adds reactor-core dependency.
            Required for reactor-optional + reactive scenario.
            Not needed for standard profile (reactor-core comes transitively).
            Usage: mvn spring-boot:run -Dreactive -Dinclude-reactor-dep
        -->
        <profile>
            <id>include-reactor-dep</id>
            <activation>
                <property>
                    <name>include-reactor-dep</name>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.projectreactor</groupId>
                    <artifactId>reactor-core</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
 </project>